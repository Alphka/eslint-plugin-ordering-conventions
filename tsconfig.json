{
	"compilerOptions": {
		"module": "NodeNext",
		"target": "ESNext",
		"allowJs": true,
		"checkJs": false,
		"strict": true,
		"moduleResolution": "NodeNext",
		"isolatedModules": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": ["node"],
		"lib": ["ESNext"],
		"noEmit": true
	},
	"include": [
		"**/*.js",
		"**/*.cjs",
		"**/*.mjs",
		"types/**/*.ts"
	],
	"exclude": [
		"node_modules"
	]
}
